{
  "expo": {
    "name": "RIVAL",
    "slug": "rival",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f4f1ea"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.anonymous.rival"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f4f1ea"
      },
      "package": "com.anonymous.rival"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "./plugins/ios/withFmtFix",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RIVAL to access your photos so you can choose a profile picture.",
          "cameraPermission": "Allow RIVAL to use your camera so you can take a profile picture."
        }
      ]
    ]
  }
}
